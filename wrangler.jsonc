{
  "name": "volk2",
  "main": "./src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/ws", "/ws/*", "/api/*"] },
  "durable_objects": { "bindings": [{ "name": "LOBBY", "class_name": "Lobby" }, { "name": "PARTIE", "class_name": "Partie" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Lobby", "Partie"] }]
}
